# ---------------------------------------------------------------------------
# Settings for Customer Records (and the converter it is built on). Copy to .env and fill in. Never commit the
# real .env.
#
#   cp .env.example .env
#
# Read by: run_local.sh / run_local.bat (the app loads .env itself) and docker-compose.yml (env_file: .env).
# Real environment variables win over values in .env. Restart the app after changing anything here.
# Write each setting as KEY=value on its own line; comments must be on their own line (starting with #),
# not after a value. Full descriptions: README → "Settings (.env)", records/config.py and converter/config.py.
# ---------------------------------------------------------------------------

# ----- Database (PostgreSQL) ------------------------------------------------
# Where the records, businesses, services and tags are kept. The app creates the database (customer_records) on
# first start when the server allows it (Homebrew's PostgreSQL on a Mac does).
# Mac with Homebrew (brew install postgresql@17 && brew services start postgresql@17): the default works.
# Windows (installer from postgresql.org): postgresql://postgres:YOUR-PASSWORD@localhost:5432/customer_records
# Docker: docker-compose.yml sets it; set POSTGRES_PASSWORD below instead.
# DATABASE_URL=postgresql://localhost:5432/customer_records
# Password of the database user in docker-compose.yml (Docker only).
POSTGRES_PASSWORD=change-me

# ----- Claude (optional) ----------------------------------------------------
# Claude API key (optional) from https://platform.claude.com — leave empty to run without Claude; everything else works
ANTHROPIC_API_KEY=

# Models (defaults shown)
# MAPPING_MODEL: column matching, Apply notes and Check for mistakes. REPAIR_MODEL: Suggest fixes (value repairs).
MAPPING_MODEL=claude-sonnet-5-5
REPAIR_MODEL=claude-haiku-5-5
# Sample values per column sent to Claude when mapping (headers + these samples only; never the whole file)
AI_SAMPLE_VALUES=15
# false = never call Claude, even when an API key is set (Apply notes is disabled, Suggest fixes is hidden,
# Check for mistakes runs the rule checks only).
AI_ENABLED=true
# Claude is only called when someone clicks Apply notes / Check for mistakes / Suggest fixes.
# true = also let Claude refine column matching automatically on every upload.
AI_AUTO_MAP=false
# Partly mask phone digits in rows sent for Claude's mistake check
AI_MASK_PHONES=true

# ----- Logins ---------------------------------------------------------------
# First admin account, created automatically on first start if no users exist.
# Remove ADMIN_PASSWORD from this file after the first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# none (default for now): no login, everyone uses the app as the local admin.
# password: per-user logins; accounts are managed on the Users page (they are kept while logins are off).
AUTH_MODE=none

# ----- App ------------------------------------------------------------------
# Browser tab title and login heading.
APP_TITLE=Customer Records
# Time zone for times shown in the app
APP_TIMEZONE=America/New_York
# Page that opens first: new (upload), imports (tracker) or find
DEFAULT_PAGE=new

# ----- Imports --------------------------------------------------------------
# Imports that can run at the same time (more queue and wait)
IMPORT_WORKERS=2
# Days to keep each import's files (original, converted, rejected rows, comparison data). 0 = keep forever.
# The import record and its counts are always kept.
FILE_RETENTION_DAYS=30
# The converter's number history isn't used by Customer Records (the records themselves are kept); this setting
# has no effect here.
NUMBER_RECORD_DAYS=0

# ----- Paths ----------------------------------------------------------------
# Paths (defaults are fine for Docker)
# RECORDS_SCHEMA_PATH: the record fields every import is mapped to (schemas/records_schema.yaml).
# SCHEMA_PATH: the converter's import format, which tags export into (schemas/target_schema.yaml); set
# EXPORT_SCHEMA_PATH to export into another format instead.
# DATA_DIR: the app's own database (converter.db: import jobs, templates) and each import's files.
# Without Docker the defaults are inside the project folder.
# RECORDS_SCHEMA_PATH=/app/schemas/records_schema.yaml
# SCHEMA_PATH=/app/schemas/target_schema.yaml
# DATA_DIR=/app/data
